  # OpenRouter free models
  - model_name: openrouter/free
    litellm_params:
      model: openrouter/free
  - model_name: openai/gpt-oss-120b:free
    litellm_params:
      model: openrouter/openai/gpt-oss-120b:free
  - model_name: google/gemma-4-31b-it:free
    litellm_params:
      model: openrouter/google/gemma-4-31b-it:free
  - model_name: nvidia/nemotron-3-ultra-550b-a55b:free
    litellm_params:
      model: openrouter/nvidia/nemotron-3-ultra-550b-a55b:free
  - model_name: nex-agi/nex-n2-pro:free
    litellm_params:
      model: openrouter/nex-agi/nex-n2-pro:free
  - model_name: poolside/laguna-m.1:free
    litellm_params:
      model: openrouter/poolside/laguna-m.1:free
  - model_name: nvidia/nemotron-3-super-120b-a12b:free
    litellm_params:
      model: openrouter/nvidia/nemotron-3-super-120b-a12b:free
  - model_name: poolside/laguna-xs.2:free
    litellm_params:
      model: openrouter/poolside/laguna-xs.2:free
  - model_name: openai/gpt-oss-20b:free
    litellm_params:
      model: openrouter/openai/gpt-oss-20b:free

general_settings:
  # LITELLM_MASTER_KEY is read from litellm.env (auto-generated on first deploy)
  master_key: "{{ headroom_litellm_master_key }}"
  forward_client_headers_to_llm_api: true
  forward_llm_provider_auth_headers: true

litellm_settings:
  drop_params: true
  # Semantic cache via Qdrant — connection params come from env (QDRANT_URL, etc.)
  # Requires OPENAI_API_KEY in litellm.env for text-embedding-3-small
  cache: true
  cache_params:
    type: "qdrant-semantic"
    qdrant_api_base: "http://qdrant:6333"
    qdrant_collection_name: "litellm_semantic_cache"
    similarity_threshold: 0.80
    qdrant_semantic_cache_embedding_model: "ollama/qwen3-embedding:0.6b"
    qdrant_semantic_cache_vector_size: 1024
  success_callback:
    - prometheus

router_settings:
  enable_pre_call_checks: true

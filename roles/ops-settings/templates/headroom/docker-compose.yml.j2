name: koeff-ai-stack

services:
  postgres:
    image: postgres:16-alpine
    container_name: koeff-ai-stack-postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: litellm
      POSTGRES_PASSWORD: "{{ litellm_db_password }}"
      POSTGRES_DB: litellm
    volumes:
      - "{{ ai_stack_data_dir }}/postgres:/var/lib/postgresql/data"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U litellm"]
      interval: 10s
      timeout: 5s
      retries: 5

  ollama:
    image: ollama/ollama:latest
    container_name: koeff-ai-stack-ollama
    restart: unless-stopped
    volumes:
      - "{{ ai_stack_data_dir }}/ollama:/root/.ollama"

  qdrant:
    image: qdrant/qdrant:latest
    container_name: koeff-ai-stack-qdrant
    restart: unless-stopped
    ports:
      - "6333:6333"
    volumes:
      - "{{ ai_stack_data_dir }}/qdrant/storage:/qdrant/storage"

  litellm:
    image: ghcr.io/berriai/litellm:main-stable
    container_name: koeff-ai-stack-litellm
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
      qdrant:
        condition: service_started
      ollama:
        condition: service_started
    ports:
      - "4000:4000"
    env_file:
      - ./litellm.env
    environment:
      QDRANT_URL: http://qdrant:6333
      QDRANT_API_BASE: http://qdrant:6333
      QDRANT_COLLECTION_NAME: litellm_semantic_cache
      QDRANT_SIMILARITY_THRESHOLD: "0.80"
      QDRANT_EMBEDDING_MODEL: ollama/qwen3-embedding:0.6b
      QDRANT_VECTOR_SIZE: "1024"
      OLLAMA_API_BASE: http://ollama:11434
      PROMETHEUS_URL: http://prometheus:9090
      UI_USERNAME: "{{ litellm_ui_username | default('admin') }}"
      UI_PASSWORD: "{{ litellm_ui_password }}"
      DATABASE_URL: "postgresql://litellm:{{ litellm_db_password }}@postgres:5432/litellm"
    volumes:
      - ./litellm-config.yaml:/opt/litellm-config.yaml:ro
      - "{{ ai_stack_data_dir }}/litellm:/app/db"
    command:
      - --config
      - /opt/litellm-config.yaml
      - --host
      - 0.0.0.0
      - --port
      - "4000"

  prometheus:
    image: prom/prometheus:latest
    container_name: koeff-ai-stack-prometheus
    restart: unless-stopped
    ports:
      - "9090:9090"
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - "{{ ai_stack_data_dir }}/prometheus:/prometheus"
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time=30d

  grafana:
    image: grafana/grafana:latest
    container_name: koeff-ai-stack-grafana
    restart: unless-stopped
    depends_on:
      - prometheus
    ports:
      - "3000:3000"
    environment:
      GF_SECURITY_ADMIN_USER: "{{ grafana_admin_user | default('admin') }}"
      GF_SECURITY_ADMIN_PASSWORD: "{{ grafana_admin_password }}"
      GF_SERVER_ROOT_URL: https://grafana.local.koeff.com
      GF_USERS_ALLOW_SIGN_UP: "false"
    volumes:
      - "{{ ai_stack_data_dir }}/grafana:/var/lib/grafana"
      - ./grafana-datasources.yaml:/etc/grafana/provisioning/datasources/datasources.yaml:ro
      - ./grafana-dashboards.yaml:/etc/grafana/provisioning/dashboards/dashboards.yaml:ro
      - ./grafana-dashboard-litellm.json:/var/lib/grafana/dashboards/litellm.json:ro
      - ./grafana-dashboard-headroom.json:/var/lib/grafana/dashboards/headroom.json:ro

  nginx-ingest:
    image: nginx:alpine
    container_name: koeff-ai-stack-nginx-ingest
    restart: unless-stopped
    depends_on:
      - litellm
    volumes:
      - ./nginx-ingest.conf:/etc/nginx/conf.d/default.conf:ro

  headroom:
    image: ghcr.io/chopratejas/headroom:latest
    container_name: koeff-ai-stack-headroom
    restart: unless-stopped
    depends_on:
      - nginx-ingest
    ports:
      - "8787:8787"
    environment:
      HEADROOM_HOST: "0.0.0.0"
      HEADROOM_PORT: "8787"
      HEADROOM_MODE: "token"
      HEADROOM_TELEMETRY: "off"
      HEADROOM_WORKSPACE_DIR: "/root/.headroom"
      HEADROOM_COMPRESSION_STABLE_AFTER_TURN: "3"
      HEADROOM_STALE_READ_COMPRESS_AFTER_TURNS: "1"
      OPENAI_TARGET_API_URL: "http://litellm:4000/v1"
      ANTHROPIC_TARGET_API_URL: "http://nginx-ingest:80"
      HEADROOM_ANTHROPIC_PRE_UPSTREAM_CONCURRENCY: "10"
      HEADROOM_ANTHROPIC_PRE_UPSTREAM_ACQUIRE_TIMEOUT_SECONDS: "120"
    volumes:
      - "{{ ai_stack_data_dir }}/headroom:/root/.headroom"

global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: litellm
    static_configs:
      - targets: ["litellm.local.koeff.com:4000"]
    metrics_path: /metrics
    authorization:
      credentials: {{ headroom_litellm_master_key }}

  - job_name: headroom
    static_configs:
      - targets: ["headroom.local.koeff.com:8787"]
    metrics_path: /metrics

  - job_name: qdrant
    static_configs:
      - targets: ["qdrant.local.koeff.com:6333"]
    metrics_path: /metrics

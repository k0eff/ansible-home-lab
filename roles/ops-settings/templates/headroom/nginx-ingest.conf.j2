# Extracts the claude.ai bearer token from Authorization and forwards it
# as x-api-key (Anthropic's native auth header) to LiteLLM.
# LiteLLM authenticates via its own master key injected here.
map $http_authorization $claude_bearer_token {
    ~^Bearer\s+(.+)$  $1;
    default           "";
}

server {
    listen 80;

    location / {
        proxy_http_version 1.1;
        proxy_set_header Connection    "";
        proxy_set_header Host          $host;
        proxy_set_header x-api-key     $claude_bearer_token;
        proxy_set_header Authorization "Bearer {{ headroom_litellm_master_key }}";

        proxy_pass http://litellm:4000;
    }
}

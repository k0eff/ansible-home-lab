# {{ ansible_managed }} — uid read from the application repo's DATASOURCE_UID (spec §5.6 D4).
apiVersion: 1
datasources:
  - name: Mimir
    uid: {{ observability_datasource_uid }}
    type: prometheus
    access: proxy
    url: http://observability-mimir:9009/prometheus
    isDefault: true
    editable: false

# Rendered by ansible-home-lab roles/ops-settings/tasks/market-news.yaml — do not edit on the host.
# Secrets come from protected/market-news/ on the controller (generated there when missing).
POSTGRES_USER={{ market_news_postgres_user }}
POSTGRES_PASSWORD={{ market_news_secrets.postgres_password }}
MARKETNEWS_DB={{ market_news_db }}
MARKETNEWS_DB_USER={{ market_news_db_user }}
MARKETNEWS_DB_PASSWORD={{ market_news_secrets.marketnews_db_password }}
GRAFANA_ADMIN_USER={{ market_news_grafana_admin_user }}
GRAFANA_ADMIN_PASSWORD={{ market_news_secrets.grafana_admin_password }}
LOKI_URL={{ market_news_loki_url }}
PG_PORT={{ market_news_pg_port }}
TEMPORAL_UI_PORT={{ market_news_temporal_ui_port }}
PROMETHEUS_PORT={{ market_news_prometheus_port }}
GRAFANA_PORT={{ market_news_grafana_port }}
BACKUP_HOST_DIR={{ market_news_backup_dir }}
# Data-provider keys (T-28, D-0005), read from the controller keychain at deploy time.
{% for name in market_news_provider_keychain_items %}
{{ name }}={{ market_news_provider_env[name] }}
{% endfor %}
SEC_USER_AGENT="{{ market_news_sec_user_agent }}"

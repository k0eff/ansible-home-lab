## Managed by ansible — roles/ops-settings/templates/omniroute/env.j2
## Edits here are overwritten on the next run. Change the role instead.
##
## Only values that differ from OmniRoute's own defaults live here; the full
## contract is documented in {{ omniroute_stack_dir }}/.env.example.
##
## Docker Compose also reads this file for ${...} interpolation in
## docker-compose.prod.yml, which is where the PROD_* ports below are used.

# --- required secrets ------------------------------------------------------
# Generated once and kept outside the checkout, in {{ omniroute_secrets_dir }}.
JWT_SECRET={{ omniroute_secrets.jwt_secret }}
API_KEY_SECRET={{ omniroute_secrets.api_key_secret }}
INITIAL_PASSWORD={{ omniroute_secrets.initial_password }}

# --- runtime ---------------------------------------------------------------
NODE_ENV=production
PORT={{ omniroute_internal_dashboard_port }}
API_PORT={{ omniroute_internal_api_port }}
OMNIROUTE_MEMORY_MB={{ omniroute_runtime_heap_mb }}

# --- host ports ------------------------------------------------------------
PROD_DASHBOARD_PORT={{ omniroute_dashboard_port }}
PROD_API_PORT={{ omniroute_api_port }}
PROD_LIVE_WS_PORT={{ omniroute_ws_port }}

# --- live-monitoring websocket ---------------------------------------------
# Bound on all interfaces because the browser reaches it from outside the
# container. The gateway does NOT forward {{ omniroute_ws_port }}, so live
# monitoring works from the LAN origin only until a listener for it is added
# to helmfile-home-lab; the public origin is allow-listed in advance.
LIVE_WS_PORT={{ omniroute_internal_ws_port }}
LIVE_WS_HOST=0.0.0.0
LIVE_WS_ALLOWED_ORIGINS=https://{{ omniroute_public_host }},http://{{ ansible_host }}:{{ omniroute_dashboard_port }}

# --- public URL ------------------------------------------------------------
# BASE_URL stays loopback on purpose: it is what server-side sync jobs call.
# NEXT_PUBLIC_BASE_URL is the canonical browser-facing origin, used for OAuth
# redirect_uri computation and generated dashboard links.
BASE_URL=http://localhost:{{ omniroute_internal_dashboard_port }}
NEXT_PUBLIC_BASE_URL=https://{{ omniroute_public_host }}
AUTH_COOKIE_SECURE={{ omniroute_auth_cookie_secure | string | lower }}

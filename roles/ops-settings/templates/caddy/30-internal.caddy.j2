# Internal hostnames (*.local.koeff.com)
#
# These three names resolve to a private IP in public Cloudflare DNS (192.168.31.237).
# No split-horizon DNS; the LAN resolver 192.168.31.149 is down, clients fall back
# to 8.8.8.8. They are HTTPS only today, matching the cluster Envoy Gateway
# (which has no HTTP listeners for these names). No :80 blocks are defined.

# grafana.local.koeff.com - Grafana metrics dashboard with live streaming panels
{{ caddy_host_grafana }} {
	import access_log
	import grafana_local_proxy
}

# prometheus.local.koeff.com - Prometheus metrics backend
{{ caddy_host_prometheus }} {
	import access_log
	import prometheus_local_proxy
}

# portainer.local.koeff.com - Portainer container management UI
{{ caddy_host_portainer }} {
	import access_log
	import portainer_local_proxy
}

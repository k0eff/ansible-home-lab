# Internal hostnames (*.local.koeff.com)
#
# This name resolves to a private IP in public Cloudflare DNS (192.168.31.237).
# No split-horizon DNS; the LAN resolver 192.168.31.149 is down, clients fall back
# to 8.8.8.8. It is HTTPS only today, matching the cluster Envoy Gateway
# (which has no HTTP listeners for this name). No :80 blocks are defined.
#
# grafana.local.koeff.com and prometheus.local.koeff.com were served here until
# 2026-09-20; koeff-ai-stack behind them is stopped, so the blocks were removed
# with it (see 10-snippets.caddy.j2). Their Cloudflare records still exist and
# now resolve to a host that has no route for them.

# portainer.local.koeff.com - Portainer container management UI
{{ caddy_host_portainer }} {
	import access_log
	import portainer_local_proxy
}

# forgejo.koeff.com - Forgejo (T-1821). forge.koeff.com is the Forge v9 UI, not Forgejo (D-0023). Resolves to vm700's private address; HTTPS only.
{{ caddy_host_forgejo }} {
	import access_log
	import forgejo_proxy
}

# market-news.koeff.com - market-news web (T-34). Resolves to vm700's private address; HTTPS only, LAN only.
{{ caddy_host_market_news }} {
	import access_log
	import market_news_proxy
}

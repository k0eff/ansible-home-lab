# Managed by ansible — roles/ops-settings/templates/caddy/env.j2
# Edits here are overwritten on the next run. Change the role instead.
#
# Cloudflare API credentials for Let's Encrypt DNS-01 ACME challenge validation.
# These are referenced from the environment on the Ansible controller with
# lookup('env', ...) and injected here at deployment time. The values are never
# echoed, logged, or copied into any public repository.
#
# lookup('env', ...) runs on the Ansible controller (the Mac), not vm700, so
# this file is templated on the controller before being transferred. The human
# must source . ./protected/main.sh cluster00 from helmfile-home-lab first, in
# the same shell where ansible-playbook runs.

CF_API_TOKEN={{ lookup('env', caddy_acme_token_env) }}
ACME_EMAIL={{ lookup('env', caddy_acme_email_env) }}

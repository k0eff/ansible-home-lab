# /opt/bg-laws/env — sourced (`set -a; . /opt/bg-laws/env; set +a`) by every
# bg-laws command (80-queue-worker-admin.md §4.3). Managed by ansible
# (roles/bg-laws); edits here are overwritten by the next play.
BG_LAWS_VAR={{ bg_laws_root }}/var
TZ=Europe/Sofia
# BG_LAWS_USER_AGENT=…           # optional override (00 §5)
# NO LLM key lives on vm700 in v1 — the worker (laptop) holds the key and
# drains var/queue; vm700 always enqueues (80 §1). Referenced-but-empty so
# the shape is ready if that decision is ever reversed.
OPENROUTER_API_KEY={{ bg_laws_openrouter_api_key }}

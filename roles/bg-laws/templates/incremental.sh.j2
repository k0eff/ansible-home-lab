#!/bin/sh
# Daily incremental + admin rebuild (80 §4.4). Cron wraps this in a
# non-blocking flock on {{ bg_laws_root }}/var/run.lock. `admin build` runs
# even when the incremental exits non-zero, so the dashboard always shows
# the latest truth. Exit codes 2 (flags written) and 3 (budget reached,
# checkpointed) are normal steady state (§4.5) — swallowed so cron only
# mails on real failures (1/4/5/6).
# Absolute bun (QA-303): cron's default PATH is /usr/bin:/bin, which misses
# /usr/local/bin — bare `bun` dies with 127 before reaching the CLI.
set -a; . {{ bg_laws_root }}/env; set +a
cd {{ bg_laws_root }}/pipeline
# --no-commit-report (pipeline deviation #79): bglaws cannot push the pipeline
# repo, and an unpushed report commit would diverge this checkout and wedge the
# worker-tick `git pull --ff-only` self-update. Reports stay on disk untracked.
/usr/local/bin/bun run src/cli/main.ts run incremental --data-repo {{ bg_laws_root }}/data --live --no-commit-report
rc=$?
/usr/local/bin/bun run src/cli/main.ts admin build --data-repo {{ bg_laws_root }}/data
case $rc in 0|2|3) exit 0;; *) exit $rc;; esac
